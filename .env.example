# Copy to .env at the repository root. Never commit real values.
APIFY_TOKEN=
EXA_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# A small feasibility run, not the entire monthly account budget.
APIFY_MAX_ITEMS=20
APIFY_MAX_TOTAL_CHARGE_USD=0.10
APIFY_TIMEOUT_SECONDS=120
APIFY_WORKFLOW_BUDGET_USD=2
NEWS_HISTORY_DAYS=90
LLM_BATCH_SIZE=12
SENTIMENT_HALF_LIFE_DAYS=3
BOOTSTRAP_SAMPLES=400
